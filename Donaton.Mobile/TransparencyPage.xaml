<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Donaton.Mobile.TransparencyPage"
             Title="Transparencia"
             BackgroundColor="#111827">

    <Grid RowDefinitions="Auto, *">
        <Label Grid.Row="0" Text="Reportes de Impacto" TextColor="White" FontSize="24" FontAttributes="Bold" Margin="20" />

        <CollectionView Grid.Row="1" x:Name="ReportsCollectionView" Margin="20,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="#1F2937" BorderColor="#374151" CornerRadius="10" Padding="0" Margin="0,0,0,20" HasShadow="False" IsClippedToBounds="True">
                        <VerticalStackLayout>
                            <Image Source="{Binding EvidenceImageUrl}" Aspect="AspectFill" HeightRequest="150" />

                            <VerticalStackLayout Padding="15" Spacing="5">
                                <Label Text="{Binding Title}" TextColor="White" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding ReportDate, StringFormat='{0:dd MMM yyyy}'}" TextColor="#9CA3AF" FontSize="12" />
                                
                                
                                <Grid ColumnDefinitions="*, Auto" Margin="0,10,0,0">
                                    <Label Grid.Column="0" Text="{Binding AmountSpent, StringFormat='Inversión: ${0:N2}'}" TextColor="#34D399" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Button Grid.Column="1" Text="Ver Detalle" BackgroundColor="#374151" TextColor="White" CornerRadius="5" HeightRequest="35" Padding="10,0" CommandParameter="{Binding .}" Clicked="OnVerDetalleClicked" />
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="Aún no hay reportes publicados." TextColor="#6B7280" HorizontalOptions="Center" VerticalOptions="Center" />
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>