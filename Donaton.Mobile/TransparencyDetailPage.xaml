<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Donaton.Mobile.TransparencyDetailPage"
             Title="Detalle del Reporte"
             BackgroundColor="#111827">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="0,0,0,30">
            <Image x:Name="EvidenceImage" Aspect="AspectFill" HeightRequest="250" />

            <VerticalStackLayout Padding="20" Spacing="15">
                <Label x:Name="TitleLabel" TextColor="White" FontSize="24" FontAttributes="Bold" />
                <Label x:Name="DateLabel" TextColor="#9CA3AF" FontSize="14" />

                <Frame BackgroundColor="#064E3B" BorderColor="#047857" CornerRadius="8" Padding="15" HasShadow="False">
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="Inversión Realizada:" TextColor="#A7F3D0" FontSize="16" />
                        <Label x:Name="AmountLabel" TextColor="White" FontSize="18" FontAttributes="Bold" />
                    </HorizontalStackLayout>
                </Frame>

                <Label Text="Descripción" TextColor="White" FontSize="18" FontAttributes="Bold" Margin="0,10,0,0" />
                <Label x:Name="DescriptionLabel" TextColor="#D1D5DB" FontSize="15" LineHeight="1.4" />

                <Label Text="Acciones Implementadas" TextColor="White" FontSize="18" FontAttributes="Bold" Margin="0,10,0,0" />
                <Label x:Name="ActionsLabel" TextColor="#D1D5DB" FontSize="15" LineHeight="1.4" />

                <Label Text="Beneficiarios" TextColor="White" FontSize="18" FontAttributes="Bold" Margin="0,10,0,0" />
                <Label x:Name="BeneficiariesLabel" TextColor="#D1D5DB" FontSize="15" LineHeight="1.4" />

                <Label x:Name="GalleryTitle" TextColor="White" FontSize="18" FontAttributes="Bold" Margin="0,15,0,0" Text="Galería de Evidencias" />
                <CarouselView x:Name="ExtraImagesCarousel" HeightRequest="180" PeekAreaInsets="30">
                    <CarouselView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="0" Margin="5" CornerRadius="8" IsClippedToBounds="True" HasShadow="False" BorderColor="#374151">
                                <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                            </Frame>
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>