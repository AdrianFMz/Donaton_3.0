<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Donaton.Mobile.MainPage"
             BackgroundColor="#111827">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Mi Historial" Clicked="OnHistorialClicked" />
        <ToolbarItem Text="Transparencia" Clicked="OnTransparenciaClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">

        <!-- ==========================================
             NUEVO: DASHBOARD GRÁFICO (Estilo Recharts)
             ========================================== -->
        <Frame Grid.Row="0" BackgroundColor="#1F2937" BorderColor="#374151" CornerRadius="12" Padding="20" HasShadow="False" Margin="20,20,20,10">
            <VerticalStackLayout Spacing="15">

                <!-- Encabezado igual a React -->
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="Impacto Global" TextColor="White" FontSize="22" FontAttributes="Bold" />
                        <Label Text="Comparativa por causa" TextColor="#9CA3AF" FontSize="12" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                        <Label Text="TOTAL HISTÓRICO" TextColor="#9CA3AF" FontSize="10" FontAttributes="Bold" HorizontalTextAlignment="End" />
                        <Label x:Name="LblTotalHistorico" Text="$0.00" TextColor="#34D399" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="End" />
                    </VerticalStackLayout>
                </Grid>

                <BoxView HeightRequest="1" Color="#374151" />

                <!-- Leyenda de colores -->
                <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                        <BoxView Color="#34D399" WidthRequest="12" HeightRequest="12" CornerRadius="2" VerticalOptions="Center"/>
                        <Label Text="Recaudado" TextColor="#D1D5DB" FontSize="12" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                        <BoxView Color="#3B82F6" WidthRequest="12" HeightRequest="12" CornerRadius="2" VerticalOptions="Center"/>
                        <Label Text="Meta" TextColor="#D1D5DB" FontSize="12" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </HorizontalStackLayout>

                
                <!-- LA GRÁFICA DE BARRAS DINÁMICA -->
                <!-- LA GRÁFICA DE BARRAS DINÁMICA -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" HeightRequest="190" Margin="0,10,0,0">
                    <StackLayout x:Name="ChartBindableLayout" Orientation="Horizontal" Spacing="20" VerticalOptions="End">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <!-- Aumentamos el WidthRequest a 90 para que los números grandes no se corten -->
                                <VerticalStackLayout VerticalOptions="End" Spacing="8" WidthRequest="90">

                                    <Grid VerticalOptions="End" ColumnDefinitions="*,*" ColumnSpacing="4">

                                        <!-- Columna Recaudado (Número + Barra Verde) -->
                                        <VerticalStackLayout Grid.Column="0" VerticalOptions="End" Spacing="2">
                                            <Label Text="{Binding CurrentAmount, StringFormat='${0:N0}'}" 
                                                   TextColor="#34D399" 
                                                   FontSize="9" 
                                                   HorizontalTextAlignment="Center" 
                                                   MaxLines="1"/>
                                            <BoxView Color="#34D399" 
                                                     HeightRequest="{Binding ChartRecaudadoHeight}" 
                                                     CornerRadius="4,4,0,0"/>
                                        </VerticalStackLayout>

                                        <!-- Columna Meta (Número + Barra Azul) -->
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="End" Spacing="2">
                                            <Label Text="{Binding GoalAmount, StringFormat='${0:N0}'}" 
                                                   TextColor="#3B82F6" 
                                                   FontSize="9" 
                                                   HorizontalTextAlignment="Center"
                                                   MaxLines="1"/>
                                            <BoxView Color="#3B82F6" 
                                                     HeightRequest="{Binding ChartMetaHeight}" 
                                                     CornerRadius="4,4,0,0"/>
                                        </VerticalStackLayout>

                                    </Grid>

                                    <!-- Nombre en el Eje X -->
                                    <Label Text="{Binding ShortTitle}" 
                                           TextColor="#9CA3AF" 
                                           FontSize="10" 
                                           HorizontalTextAlignment="Center" 
                                           MaxLines="1" 
                                           LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                </ScrollView>

            </VerticalStackLayout>
        </Frame>

        <!-- ==========================================
             CATÁLOGO DE CAUSAS 
             ========================================== -->
        <CollectionView x:Name="CausesCollectionView" Grid.Row="1" Margin="20,10,20,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="#1F2937" 
                           BorderColor="#374151" 
                           CornerRadius="15" 
                           Margin="0,0,0,20" 
                           Padding="0" 
                           IsClippedToBounds="True" 
                           HasShadow="True">

                        <VerticalStackLayout>
                            <Image Source="{Binding ImageUrl}" Aspect="AspectFill" HeightRequest="180" />

                            <VerticalStackLayout Padding="20" Spacing="8">
                                <Label Text="{Binding Title}" TextColor="White" FontSize="20" FontAttributes="Bold" />
                                <Label Text="{Binding Description}" TextColor="#9CA3AF" MaxLines="2" LineBreakMode="TailTruncation" />

                                <!-- Montos y Barra Individual -->
                                <VerticalStackLayout Margin="0,10,0,10" Spacing="5">
                                    <Grid ColumnDefinitions="*,*">
                                        <Label Grid.Column="0" Text="{Binding CurrentAmount, StringFormat='Recaudado: ${0:N0}'}" TextColor="#D1D5DB" FontSize="12" />
                                        <Label Grid.Column="1" Text="{Binding GoalAmount, StringFormat='Meta: ${0:N0}'}" TextColor="#D1D5DB" FontSize="12" HorizontalOptions="End" />
                                    </Grid>
                                    <ProgressBar Progress="{Binding Progress}" ProgressColor="#34D399" HeightRequest="8" />
                                </VerticalStackLayout>

                                <Button Text="Apoyar esta causa" 
                                        BackgroundColor="#2563EB" 
                                        TextColor="White"
                                        CornerRadius="8"
                                        HeightRequest="45"
                                        FontAttributes="Bold"
                                        Clicked="OnDonarClicked" 
                                        CommandParameter="{Binding .}"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>